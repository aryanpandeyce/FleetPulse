# Build stage
FROM golang:alpine AS builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/telemetry-service ./services/telemetry-service/cmd

# Final minimal runtime
FROM alpine:3.19

RUN addgroup -S -g 10001 fleetpulse && \
    adduser -S -u 10001 -G fleetpulse fleetpulse

USER fleetpulse:fleetpulse
WORKDIR /home/fleetpulse

COPY --from=builder /bin/telemetry-service /usr/local/bin/telemetry-service

EXPOSE 50052
ENTRYPOINT ["/usr/local/bin/telemetry-service"]
