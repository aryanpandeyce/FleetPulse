# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/inventory-service ./services/inventory-service/cmd

# Final minimal runtime
FROM alpine:3.19

RUN addgroup -S -g 10001 fleetpulse && \
    adduser -S -u 10001 -G fleetpulse fleetpulse

USER fleetpulse:fleetpulse
WORKDIR /home/fleetpulse

COPY --from=builder /bin/inventory-service /usr/local/bin/inventory-service

EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/inventory-service"]
