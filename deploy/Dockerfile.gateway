# Build stage
FROM golang:alpine AS builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/gateway ./services/gateway/cmd

# Final minimal runtime
FROM alpine:3.19

RUN addgroup -S -g 10001 fleetpulse && \
    adduser -S -u 10001 -G fleetpulse fleetpulse

USER fleetpulse:fleetpulse
WORKDIR /home/fleetpulse

COPY --from=builder /bin/gateway /usr/local/bin/gateway

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/gateway"]
